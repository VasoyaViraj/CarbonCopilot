# EcoTrace AI — AI service (Python + FastAPI, LangChain / LangGraph / MCP)
# Copy to ai-service/.env and fill in the secrets. Never commit .env.
# Read by app/config.py. An empty value overrides the built-in default, so remove a line
# rather than leaving it blank if you want the default.

# --- Server ---
# Port to serve on. Pass it to uvicorn when starting the service:
#   uvicorn app.main:app --port 8000
AI_SERVICE_PORT=8000
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# --- Backend (deterministic business APIs; the only source of factory data) ---
# Express API base URL, including the /api prefix.
BACKEND_INTERNAL_URL=http://localhost:5000/api
# Shared secret between Express and this service; must be identical to AI_SERVICE_TOKEN in
# backend/.env (at least 16 characters, e.g. openssl rand -hex 32). Express sends it on every
# /copilot call and this service sends it back on its tool calls to the API.
AI_SERVICE_TOKEN=

# --- LLM (reasoning / explanation / orchestration only; never authoritative arithmetic) ---
# Only Google Gemini is supported (langchain-google-genai).
LLM_PROVIDER=google
# Any Gemini model id your API key can use; check Google AI Studio for currently available models.
LLM_MODEL=gemini-2.5-flash
# Google AI Studio API key. Without it the copilot still answers, but only by listing the
# deterministic tool results (no natural-language explanation, no parsing of vague scenarios).
LLM_API_KEY=
# 0 keeps explanations reproducible. Must be between 0 and 1.
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=30
