# EcoTrace AI — frontend (React + Vite)
# Copy to frontend/.env. Vite exposes only VITE_* variables, and it bakes them into the
# browser bundle at build time — never put secrets here.

# Base URL of the Express API, including the /api prefix.
# The backend's FRONTEND_URL (CORS) must list this app's origin — http://localhost:5173 in development.
VITE_API_BASE_URL=http://localhost:5000/api
