# --- Server ---
NODE_ENV=development
PORT=5000

# --- PostgreSQL (source of truth) ---
# Local:  postgresql://ecotrace:ecotrace@localhost:5432/ecotrace?schema=public
DATABASE_URL=""

# --- Authentication ---
# Required. Use a long random value, e.g. `openssl rand -hex 32`.
JWT_SECRET=""
JWT_EXPIRES_IN=1d

# --- CORS ---
# Comma-separated list of allowed browser origins.
FRONTEND_URL=http://localhost:5173

# --- AI service (Python / FastAPI) ---
AI_SERVICE_URL=http://localhost:8000
# Shared secret for Express <-> AI service internal calls. Never sent to the browser.
AI_SERVICE_TOKEN=""
AI_TIMEOUT_MS=30000

# --- Uploads ---
MAX_UPLOAD_SIZE_MB=5

# --- Abuse protection ---
# Failed sign-ins allowed per IP per 15 minutes (also caps registrations per IP per hour).
AUTH_RATE_LIMIT_MAX=10
# Requests allowed per IP per minute across the whole API.
API_RATE_LIMIT_MAX=300
# Reverse proxies in front of the API (0 = clients connect directly). Set to 1 behind a
# single load balancer so rate limits see real client IPs; never higher than the real hop count.
TRUST_PROXY_HOPS=0

# --- Seed (development / demo only) ---
# Password for the seeded demo accounts (admin|operator|consultant|regulator@ecotrace.demo).
DEMO_USER_PASSWORD=EcoTrace@Demo1
