# --- Server ---
NODE_ENV=development
PORT=5000

# --- PostgreSQL (source of truth) ---
# Local:  postgresql://ecotrace:ecotrace@localhost:5432/ecotrace?schema=public
DATABASE_URL=""

# --- Authentication ---
# Required. Use a long random value, e.g. `openssl rand -hex 32`.
JWT_SECRET=""
JWT_EXPIRES_IN=1d

# --- CORS ---
# Comma-separated list of allowed browser origins.
FRONTEND_URL=http://localhost:5173

# --- AI service (Python / FastAPI) ---
AI_SERVICE_URL=http://localhost:8000
# Shared secret for Express <-> AI service internal calls. Never sent to the browser.
AI_SERVICE_TOKEN=""
AI_TIMEOUT_MS=30000

# --- Uploads ---
MAX_UPLOAD_SIZE_MB=5
