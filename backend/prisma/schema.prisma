generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  FACTORY_OPERATOR
  CONSULTANT
  REGULATOR
}

enum ActivitySource {
  MANUAL
  CSV
  SIMULATION
}

enum RecommendationStatus {
  PENDING
  ACCEPTED
  REJECTED
  IMPLEMENTED
}

enum AiMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum SimulationStatus {
  NORMAL
  ALERT
}

// ---------------------------------------------------------------------------
// Tenancy & identity
// ---------------------------------------------------------------------------

model Organization {
  id            Int      @id @default(autoincrement())
  name          String
  industry_type String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  users     User[]
  factories Factory[]

  @@map("organizations")
}

model User {
  id              Int      @id @default(autoincrement())
  organization_id Int
  name            String
  email           String   @unique
  password_hash   String
  role            Role     @default(FACTORY_OPERATOR)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  organization     Organization     @relation(fields: [organization_id], references: [id])
  ai_conversations AiConversation[]

  @@index([organization_id])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Factory structure
// ---------------------------------------------------------------------------

model Factory {
  id                  Int      @id @default(autoincrement())
  organization_id     Int
  name                String
  industry_type       String?
  location            String?
  production_capacity Float?
  production_unit     String?
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  organization     Organization     @relation(fields: [organization_id], references: [id])
  processes        Process[]
  materials        Material[]
  wastes           Waste[]
  recommendations  Recommendation[]
  scenarios        Scenario[]
  ai_conversations AiConversation[]

  @@index([organization_id])
  @@map("factories")
}

model Process {
  id           Int      @id @default(autoincrement())
  factory_id   Int
  name         String
  process_type String?
  description  String?
  created_at   DateTime @default(now())

  factory             Factory             @relation(fields: [factory_id], references: [id], onDelete: Cascade)
  activities          Activity[]
  wastes              Waste[]
  recommendations     Recommendation[]
  simulation_readings SimulationReading[]

  // CSV rows resolve processes by name within a factory, so names must be unambiguous.
  @@unique([factory_id, name])
  @@map("processes")
}

// ---------------------------------------------------------------------------
// Operational data & deterministic emissions
// ---------------------------------------------------------------------------

model Activity {
  id                  Int            @id @default(autoincrement())
  process_id          Int
  activity_date       DateTime
  energy_type         String
  quantity            Float
  unit                String
  production_quantity Float?
  production_unit     String?
  source              ActivitySource @default(MANUAL)
  created_at          DateTime       @default(now())

  process   Process    @relation(fields: [process_id], references: [id], onDelete: Cascade)
  emissions Emission[]

  @@index([process_id, activity_date])
  @@map("activities")
}

model EmissionFactor {
  id         Int      @id @default(autoincrement())
  category   String
  source     String?
  fuel_type  String?
  // Activity unit the factor applies to (e.g. kWh, m3, L, tonne).
  unit       String
  // Factor value, expressed in co2e_unit per activity unit.
  factor     Float
  co2e_unit  String   @default("kgCO2e")
  region     String?
  year       Int?
  reference  String?
  created_at DateTime @default(now())

  emissions Emission[]

  @@index([category, fuel_type, unit])
  @@map("emission_factors")
}

model Emission {
  id                 Int      @id @default(autoincrement())
  activity_id        Int
  emission_factor_id Int
  co2e_value         Float
  co2e_unit          String   @default("tCO2e")
  calculation_method String?
  calculated_at      DateTime @default(now())

  activity        Activity       @relation(fields: [activity_id], references: [id], onDelete: Cascade)
  // Restrict: a factor that explains historical emissions must not be deleted.
  emission_factor EmissionFactor @relation(fields: [emission_factor_id], references: [id], onDelete: Restrict)

  @@index([activity_id])
  @@index([emission_factor_id])
  @@map("emissions")
}

model Material {
  id            Int      @id @default(autoincrement())
  factory_id    Int
  name          String
  category      String?
  material_type String?
  quantity      Float
  unit          String
  created_at    DateTime @default(now())

  factory Factory @relation(fields: [factory_id], references: [id], onDelete: Cascade)

  @@index([factory_id])
  @@map("materials")
}

model Waste {
  id              Int      @id @default(autoincrement())
  factory_id      Int
  process_id      Int
  waste_type      String
  quantity        Float
  unit            String
  disposal_method String?
  created_at      DateTime @default(now())

  factory Factory @relation(fields: [factory_id], references: [id], onDelete: Cascade)
  process Process @relation(fields: [process_id], references: [id], onDelete: Cascade)

  @@index([factory_id])
  @@index([process_id])
  @@map("waste")
}

// ---------------------------------------------------------------------------
// Circular economy, recommendations & scenarios
// ---------------------------------------------------------------------------

model CircularAlternative {
  id                        Int      @id @default(autoincrement())
  category                  String
  current_option            String
  alternative_option        String
  description               String?
  reduction_percent         Float?
  cost_level                String?
  implementation_difficulty String?
  estimated_payback_years   Float?
  circularity_score         Float?
  created_at                DateTime @default(now())

  recommendations Recommendation[]

  @@unique([current_option, alternative_option])
  @@index([category])
  @@map("circular_alternatives")
}

model Recommendation {
  id                  Int                  @id @default(autoincrement())
  factory_id          Int
  process_id          Int?
  alternative_id      Int
  score               Float?
  estimated_reduction Float?
  estimated_cost      Float?
  estimated_savings   Float?
  payback_period      Float?
  reason              String?
  status              RecommendationStatus @default(PENDING)
  created_at          DateTime             @default(now())

  factory     Factory             @relation(fields: [factory_id], references: [id], onDelete: Cascade)
  process     Process?            @relation(fields: [process_id], references: [id], onDelete: SetNull)
  alternative CircularAlternative @relation(fields: [alternative_id], references: [id], onDelete: Restrict)

  @@index([factory_id])
  @@index([process_id])
  @@index([alternative_id])
  @@map("recommendations")
}

// Scenario outputs are stored separately and never overwrite baseline activities/emissions.
model Scenario {
  id                 Int      @id @default(autoincrement())
  factory_id         Int
  name               String
  description        String?
  baseline_emission  Float?
  projected_emission Float?
  reduction_amount   Float?
  reduction_percent  Float?
  estimated_cost     Float?
  estimated_savings  Float?
  payback_period     Float?
  created_at         DateTime @default(now())

  factory Factory @relation(fields: [factory_id], references: [id], onDelete: Cascade)

  @@index([factory_id])
  @@map("scenarios")
}

// ---------------------------------------------------------------------------
// AI Copilot history
// ---------------------------------------------------------------------------

model AiConversation {
  id         Int      @id @default(autoincrement())
  user_id    Int
  factory_id Int
  created_at DateTime @default(now())

  user     User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  factory  Factory     @relation(fields: [factory_id], references: [id], onDelete: Cascade)
  messages AiMessage[]

  @@index([user_id])
  @@index([factory_id])
  @@map("ai_conversations")
}

model AiMessage {
  id              Int           @id @default(autoincrement())
  conversation_id Int
  role            AiMessageRole
  content         String
  // Optional tool metadata (tool names / structured results); never secrets or internal prompts.
  tool_used       Json?
  created_at      DateTime      @default(now())

  conversation AiConversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)

  @@index([conversation_id, created_at])
  @@map("ai_messages")
}

// ---------------------------------------------------------------------------
// Simulated readings (hackathon stand-in for sensors; always labelled simulated)
// ---------------------------------------------------------------------------

model SimulationReading {
  id                 Int              @id @default(autoincrement())
  process_id         Int
  timestamp          DateTime         @default(now())
  temperature        Float?
  energy_consumption Float?
  fuel_consumption   Float?
  estimated_emission Float?
  status             SimulationStatus @default(NORMAL)
  is_simulated       Boolean          @default(true)

  process Process @relation(fields: [process_id], references: [id], onDelete: Cascade)

  @@index([process_id, timestamp])
  @@map("simulation_readings")
}
