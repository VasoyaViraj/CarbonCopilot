# EcoTrace AI — backend (Node + Express)
# Copy to backend/.env and fill in the secrets. Never commit .env.
# Every variable is validated at startup (src/config/env.js); the server exits with a
# clear message if a required value is missing or invalid.

# --- Server ---
# development | test | production
NODE_ENV=development
PORT=5000

# --- PostgreSQL (source of truth) --- REQUIRED
# Matches the local database in docker-compose.yml (`docker compose up -d postgres`).
DATABASE_URL=postgresql://ecotrace:ecotrace@localhost:5432/ecotrace?schema=public

# --- Authentication --- REQUIRED
# At least 16 characters. Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=1d

# --- CORS ---
# Comma-separated list of browser origins allowed to call the API (the frontend URL).
FRONTEND_URL=http://localhost:5173

# --- AI service (Python / FastAPI) ---
AI_SERVICE_URL=http://localhost:8000
# Shared secret between Express and the AI service; must be identical to AI_SERVICE_TOKEN in
# ai-service/.env. At least 16 characters (openssl rand -hex 32). Never sent to the browser.
# Leave empty to disable the AI Copilot. With it set, the AI service can only read data and run
# stateless calculations as the user whose question Express forwarded — it can never write.
AI_SERVICE_TOKEN=
# How long Express waits for a copilot answer before returning 504 AI_TIMEOUT.
AI_TIMEOUT_MS=30000

# --- Uploads ---
# Maximum CSV upload size.
MAX_UPLOAD_SIZE_MB=5

# --- Abuse protection ---
# Failed sign-ins allowed per IP per 15 minutes (also caps registrations per IP per hour).
AUTH_RATE_LIMIT_MAX=10
# Requests allowed per IP per minute across the whole API.
API_RATE_LIMIT_MAX=300
# Reverse proxies in front of the API (0 = clients connect directly). Set to 1 behind a single
# load balancer so rate limits see real client IPs; never higher than the real hop count.
TRUST_PROXY_HOPS=0

# --- Hotspot severity (share of a factory's total emissions, in %) ---
# Above CRITICAL → CRITICAL; HIGH up to CRITICAL → HIGH; MEDIUM up to HIGH → MEDIUM; below → LOW.
# Must satisfy CRITICAL > HIGH > MEDIUM.
HOTSPOT_CRITICAL_PERCENT=40
HOTSPOT_HIGH_PERCENT=25
HOTSPOT_MEDIUM_PERCENT=10

# --- Seed (development / demo only; read by `npm run db:seed`) ---
# Password for the seeded demo accounts (admin|operator|consultant|regulator@ecotrace.demo).
# With NODE_ENV=production the seed refuses to run while this is the published default.
DEMO_USER_PASSWORD=EcoTrace@Demo1
